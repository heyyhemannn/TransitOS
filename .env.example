# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/stms_dev"
DIRECT_URL="postgresql://postgres:password@localhost:5432/stms_dev"

# Supabase (production)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZkbGdqcHRicWdoaGdlaWN6aWphIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI2Mzg2MjYsImV4cCI6MjA5ODIxNDYyNn0.Q4LtHaYE1rie6w3P_FgUQL-NYkflNsW_ei0pShnYUvA"
SUPABASE_STORAGE_BUCKET="receipts"

# ─────────────────────────────────────────────
# REDIS / UPSTASH
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Upstash (production)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─────────────────────────────────────────────
# JWT / AUTH
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET="change-this-to-a-very-long-random-string-min-64-chars"
JWT_REFRESH_SECRET="change-this-to-another-very-long-random-string-min-64-chars"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_NAME="TransitOS"

# ─────────────────────────────────────────────
# BUSINESS SETTINGS (also stored in DB Settings table)
# ─────────────────────────────────────────────
BUSINESS_NAME="Star Transport Services"
ADMIN_WHATSAPP="91XXXXXXXXXX"
UPI_ID="yourupi@ybl"

# ─────────────────────────────────────────────
# WHATSAPP
# ─────────────────────────────────────────────
WHATSAPP_SESSION_PATH="./whatsapp-session"

# ─────────────────────────────────────────────
# SMS GATEWAY (Android gateway for UPI SMS parsing)
# ─────────────────────────────────────────────
ANDROID_GATEWAY_URL="http://YOUR_ANDROID_DEVICE_IP:PORT"
ANDROID_GATEWAY_TOKEN="your-gateway-token"

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ─────────────────────────────────────────────
# PUPPETEER / RECEIPT GENERATION
# ─────────────────────────────────────────────
CHROMIUM_PATH=""
